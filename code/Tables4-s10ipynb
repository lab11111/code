   "source": [
    "#!/usr/bin/env python3\n",
    "# -*- coding: utf-8 -*-\n",
    "\"\"\"Create prioritized supplementary CSVs, one file per table number.\n",
    "\n",
    "Project layout expected:\n",
    " /home/t440/machine/machine2/\n",
    "   AD_microglia_HTS_LTS_TWAS_genes_ML.csv\n",
    "   rf/ ... CSV results ...\n",
    "   lr/ ... CSV results ...\n",
    "   gbm/ ... CSV results ...\n",
    "   svm/ ... CSV results ...\n",
    "   xgboost/ ... CSV results ...\n",
    "   catboost/ ... CSV results ...\n",
    "\n",
    "Run from Jupyter: %run generate_supplementary_tables_priority.py\n",
    "Tables S4-S7 are cited in the manuscript, followed by S8-S10.\n",
    "Optional S11 is cell-level prediction data for reproducibility.\n",
    "Only merges existing model output; does not train any models.\n",
    "Requires: pandas, numpy (already used in the ML notebooks).\n",
    "\"\"\"\n",
    "from __future__ import annotations\n",
    "\n",
    "from pathlib import Path\n",
    "import pandas as pd\n",
    "import numpy as np\n",
    "\n",
    "# ---- Modify these paths ONLY if your own location differs ----\n",
    "PROJECT_DIR = Path('/home/t440/machine/machine2')\n",
    "DATA_FILE = PROJECT_DIR / 'AD_microglia_HTS_LTS_TWAS_genes_ML.csv'\n",
    "OUTPUT_DIR = PROJECT_DIR / 'supplementary_tables_priority'\n",
    "\n",
    "# Optional: cell-level predictions can be large and may contain cell/donor IDs.\n",
    "# Set True only if needed for internal reproduction, after privacy review.\n",
    "EXPORT_S11_CELL_PREDICTIONS = False\n",
    "\n",
    "# In the order used in the paper's Methods section.\n",
    "MODELS = ('RF', 'LR', 'GBM', 'SVM', 'XGB', 'CAT')\n",
    "MODEL_NAMES = {\n",
    "    'RF': 'Random forest (RF)',\n",
    "    'LR': 'Logistic regression (LR)',\n",
    "    'GBM': 'Gradient boosting machine (GBM)',\n",
    "    'SVM': 'Support vector machine (SVM)',\n",
    "    'XGB': 'XGBoost',\n",
    "    'CAT': 'CatBoost',\n",
    "}\n",
    "MODEL_DIRS = {\n",
    "    'RF': 'rf', 'LR': 'lr', 'GBM': 'gbm',\n",
    "    'SVM': 'svm', 'XGB': 'xgboost', 'CAT': 'catboost',\n",
    "}\n",
    "IMPORTANCE_FIELDS = {\n",
    "    'RF': ('mean_importance', 'Model-derived importance'),\n",
    "    'LR': ('mean_abs_coefficient', 'Absolute standardized coefficient'),\n",
    "    'GBM': ('mean_importance', 'Model-derived importance'),\n",
    "    'SVM': ('mean_abs_coefficient', 'Absolute standardized coefficient'),\n",
    "    'XGB': ('mean_abs_SHAP', 'Donor-balanced mean absolute SHAP'),\n",
    "    'CAT': ('mean_abs_SHAP', 'Donor-balanced mean absolute SHAP'),\n",
    "}\n",
    "TUNING_FILES = {\n",
    "    m: f'{m}_inner_parameter_tuning.csv' for m in MODELS\n",
    "}\n",
    "TUNING_FILES.update({'LR': 'LR_inner_C_tuning.csv', 'SVM': 'SVM_inner_C_tuning.csv'})\n",
    "ARTICLE_CONSENSUS_ORDER = ('SFMBT2', 'LCORL', 'ZFP36L2')\n",
    "\n",
    "# Priority after paper-cited S4-S7 and the parameter summary S8:\n",
    "# S9: within-fold Top 20 genes (supports selection robustness / Fig. 5E)\n",
    "# S10: all-fold full gene importance (reproducibility of S6 and S9)\n",
    "# S11: cell-level held-out predictions, OFF by default (reproducibility of Fig. 5C)\n",
    "FOLD_IMPORTANCE_FILES = {\n",
    "    'RF': 'RF_all_fold_importances.csv',\n",
    "    'LR': 'LR_all_fold_coefficients.csv',\n",
    "    'GBM': 'GBM_all_fold_importances.csv',\n",
    "    'SVM': 'SVM_all_fold_coefficients.csv',\n",
    "    'XGB': 'XGB_all_fold_SHAP_importance.csv',\n",
    "    'CAT': 'CAT_all_fold_SHAP_importance.csv',\n",
    "}\n",
    "FOLD_SCORE_COLS = {\n",
    "    'RF': 'importance', 'LR': 'abs_coefficient', 'GBM': 'importance',\n",
    "    'SVM': 'abs_coefficient', 'XGB': 'mean_abs_SHAP', 'CAT': 'mean_abs_SHAP',\n",
    "}\n",
    "\n",
    "\n",
    "def find_model_file(model: str, filename: str) -> Path:\n",
    "    \"\"\"Search only the relevant model directory; avoid mixing previous project runs.\"\"\"\n",
    "    model_dir = PROJECT_DIR / MODEL_DIRS[model]\n",
    "    if not model_dir.is_dir():\n",
    "        raise FileNotFoundError(f'Cannot find model folder: {model_dir}')\n",
    "    matches = sorted(p for p in model_dir.rglob(filename) if p.is_file())\n",
    "    if len(matches) != 1:\n",
    "        raise FileNotFoundError(\n",
    "            f'{model}: expected exactly one {filename} in {model_dir}; '\n",
    "            f'found {len(matches)}. Matches: {[str(p) for p in matches]}'\n",
    "        )\n",
    "    return matches[0]\n",
    "\n",
    "\n",
    "def read_model_file(model: str, filename: str, required=()) -> pd.DataFrame:\n",
    "    filename_path = find_model_file(model, filename)\n",
    "    df = pd.read_csv(filename_path)\n",
    "    missing = set(required) - set(df.columns)\n",
    "    if missing:\n",
    "        raise ValueError(f'{filename_path}: missing columns {sorted(missing)}')\n",
    "    return df\n",
    "\n",
    "\n",
    "def fmt(x):\n",
    "    if pd.isna(x):\n",
    "        return 'None'\n",
    "    if isinstance(x, str):\n",
    "        return x\n",
    "    try:\n",
    "        v = float(x)\n",
    "        return str(int(v)) if v.is_integer() else f'{v:.12g}'\n",
    "    except (TypeError, ValueError):\n",
    "        return str(x)\n",
    "\n",
    "\n",
    "def save(df: pd.DataFrame, number: str) -> None:\n",
    "    dest = OUTPUT_DIR / f'Table_{number}.csv'\n",
    "    df.to_csv(dest, index=False, encoding='utf-8-sig')\n",
    "    print(f'  Saved {dest.name}: {len(df)} rows')\n",
    "\n",
    "\n",
    "def generate_tables():\n",
    "    if not DATA_FILE.is_file():\n",
    "        raise FileNotFoundError(f'Raw expression matrix not found: {DATA_FILE}')\n",
    "\n",
    "    # Check all necessary source files BEFORE creating the final files.\n",
    "    for model in MODELS:\n",
    "        for fname in (\n",
    "            f'{model}_outer_LODO_performance.csv',\n",
    "            f'{model}_feature_stability_summary.csv',\n",
    "            TUNING_FILES[model],\n",
    "        ):\n",
    "            find_model_file(model, fname)\n",
    "\n",
    "    # S4: Donor counts and proportions. Preserve donor appearance order in raw matrix.\n",
    "    raw = pd.read_csv(DATA_FILE, usecols=lambda c: c in ('individual', 'label'))\n",
    "    if set(raw.columns) != {'individual', 'label'}:\n",
    "        raise ValueError(\"Raw expression matrix needs columns 'individual' and 'label'.\")\n",
    "    if raw.isna().any().any():\n",
    "        raise ValueError('Raw expression matrix has missing donor ID or class label.')\n",
    "    raw['individual'] = raw['individual'].astype(str)\n",
    "    raw['label'] = pd.to_numeric(raw['label'], errors='raise').astype(int)\n",
    "    if not set(raw['label'].unique()).issubset({0, 1}):\n",
    "        raise ValueError('The label column must contain 1=HTS and 0=LTS.')\n",
    "    donor_order = raw['individual'].drop_duplicates().tolist()\n",
    "    c = pd.crosstab(raw['individual'], raw['label']).reindex(\n",
    "        index=donor_order, columns=[1, 0], fill_value=0\n",
    "    )\n",
    "    c.columns = ['n_HTS', 'n_LTS']\n",
    "    s4 = c.reset_index().rename(columns={'individual': 'donor'})\n",
    "    s4['n_total'] = s4.n_HTS + s4.n_LTS\n",
    "    s4['HTS_proportion'] = s4.n_HTS / s4.n_total\n",
    "    s4['LTS_proportion'] = s4.n_LTS / s4.n_total\n",
    "    s4['HTS_percent'] = (s4.HTS_proportion * 100).round(2)\n",
    "    s4['LTS_percent'] = (s4.LTS_proportion * 100).round(2)\n",
    "    if len(s4) != 9:\n",
    "        print(f'WARNING: raw input contains {len(s4)} donors, manuscript states nine.')\n",
    "\n",
    "    # S5: one donor-level table; model median/Q1/Q3 columns included in SAME file.\n",
    "    perf_frames = []\n",
    "    perf_by_model = {}\n",
    "    for model in MODELS:\n",
    "        perf = read_model_file(model, f'{model}_outer_LODO_performance.csv',\n",
    "                               ('test_donor', 'ROC_AUC', 'AP', 'n_HTS', 'n_LTS'))\n",
    "        perf['model'] = model\n",
    "        perf['model_full_name'] = MODEL_NAMES[model]\n",
    "        perf['test_donor'] = perf['test_donor'].astype(str)\n",
    "        perf['HTS_prevalence'] = perf.n_HTS / (perf.n_HTS + perf.n_LTS)\n",
    "        perf_by_model[model] = perf.copy()\n",
    "        perf_frames.append(perf)\n",
    "    perf_all = pd.concat(perf_frames, ignore_index=True)\n",
    "    summary = perf_all.groupby('model', sort=False).agg(\n",
    "        n_donors=('test_donor', 'nunique'),\n",
    "        AUROC_median=('ROC_AUC', 'median'),\n",
    "        AUROC_Q1=('ROC_AUC', lambda x: x.quantile(0.25)),\n",
    "        AUROC_Q3=('ROC_AUC', lambda x: x.quantile(0.75)),\n",
    "        AP_median=('AP', 'median'),\n",
    "        AP_Q1=('AP', lambda x: x.quantile(0.25)),\n",
    "        AP_Q3=('AP', lambda x: x.quantile(0.75)),\n",
    "    ).reset_index()\n",
    "    s5 = perf_all.merge(summary, on='model', how='left', validate='many_to_one')\n",
    "    s5 = s5.reindex(columns=[\n",
    "        'model', 'model_full_name', 'test_donor', 'fold', 'n_test_cells',\n",
    "        'n_HTS', 'n_LTS', 'HTS_prevalence', 'ROC_AUC', 'AP',\n",
    "        'n_donors', 'AUROC_median', 'AUROC_Q1', 'AUROC_Q3',\n",
    "        'AP_median', 'AP_Q1', 'AP_Q3',\n",
    "    ])\n",
    "    s5['_model_order'] = pd.Categorical(s5.model, categories=MODELS, ordered=True)\n",
    "    s5['_donor_order'] = pd.Categorical(s5.test_donor, categories=donor_order, ordered=True)\n",
    "    s5 = s5.sort_values(['_model_order', '_donor_order'], kind='stable').drop(\n",
    "        columns=['_model_order', '_donor_order']\n",
    "    )\n",
    "    raw_counts = s4.set_index('donor')\n",
    "    for row in s5.itertuples(index=False):\n",
    "        if row.test_donor not in raw_counts.index:\n",
    "            print(f'WARNING: {row.model} donor {row.test_donor} not present in S4.')\n",
    "        elif (int(row.n_HTS) != int(raw_counts.loc[row.test_donor, 'n_HTS']) or\n",
    "              int(row.n_LTS) != int(raw_counts.loc[row.test_donor, 'n_LTS'])):\n",
    "            print(f'WARNING: donor-cell counts differ for {row.model}, {row.test_donor}.')\n",
    "\n",
    "    # S6: ranks and stability, model order as in article, then rank ascending.\n",
    "    rank_frames = []\n",
    "    for model in MODELS:\n",
    "        df = read_model_file(model, f'{model}_feature_stability_summary.csv',\n",
    "                             ('gene', 'top20_count'))\n",
    "        score_col, importance_name = IMPORTANCE_FIELDS[model]\n",
    "        if score_col not in df.columns:\n",
    "            raise ValueError(f'{model} feature summary missing {score_col}.')\n",
    "        if df.gene.duplicated().any():\n",
    "            raise ValueError(f'{model} feature summary contains duplicated genes.')\n",
    "        df['top20_count'] = pd.to_numeric(df.top20_count, errors='raise').astype(int)\n",
    "        df[score_col] = pd.to_numeric(df[score_col], errors='raise')\n",
    "        df = df.sort_values(['top20_count', score_col], ascending=[False, False], kind='stable')\n",
    "        if 'final_rank' not in df.columns:\n",
    "            df['final_rank'] = np.arange(1, len(df) + 1)\n",
    "        else:\n",
    "            df['final_rank'] = pd.to_numeric(df.final_rank, errors='raise').astype(int)\n",
    "            df = df.sort_values('final_rank', kind='stable')\n",
    "        n_folds = int(perf_all.loc[perf_all.model.eq(model), 'test_donor'].nunique())\n",
    "        sub = pd.DataFrame({\n",
    "            'model': model, 'gene': df.gene.values,\n",
    "            'final_rank': df.final_rank.values,\n",
    "            'top20_count': df.top20_count.values,\n",
    "            'n_outer_folds': n_folds,\n",
    "            'top20_frequency': df.top20_count.values / n_folds,\n",
    "            'importance_method': importance_name,\n",
    "            'mean_importance_within_model': df[score_col].values,\n",
    "            'stable_top20_ge6_folds': df.top20_count.values >= 6,\n",
    "        })\n",
    "        for extra in ('mean_HTS_minus_LTS', 'expression_direction',\n",
    "                      'mean_expression_direction_consistency'):\n",
    "            sub[extra] = df[extra].values if extra in df.columns else np.nan\n",
    "        rank_frames.append(sub)\n",
    "    s6 = pd.concat(rank_frames, ignore_index=True)\n",
    "    s6['_model_order'] = pd.Categorical(s6.model, categories=MODELS, ordered=True)\n",
    "    s6 = s6.sort_values(['_model_order', 'final_rank'], kind='stable').drop(columns='_model_order')\n",
    "\n",
    "    # S7: SINGLE wide matrix of top-ten ranks + six-model consensus; article genes first.\n",
    "    top10 = s6[s6.final_rank.le(10)].copy()\n",
    "    if any(int(top10.model.eq(m).sum()) != 10 for m in MODELS):\n",
    "        raise ValueError('Each of the six models must contain exactly ten Top 10 genes.')\n",
    "    wide = top10.pivot(index='gene', columns='model', values='final_rank').reindex(columns=MODELS)\n",
    "    wide.columns = [f'rank_{m}' for m in MODELS]\n",
    "    s7 = wide.reset_index()\n",
    "    rank_cols = [f'rank_{m}' for m in MODELS]\n",
    "    s7['n_models_top10'] = s7[rank_cols].notna().sum(axis=1)\n",
    "    s7['consensus_all_six'] = s7.n_models_top10.eq(6)\n",
    "    s7['mean_rank_among_selected_models'] = s7[rank_cols].mean(axis=1)\n",
    "    s7['_article_gene_order'] = s7.gene.map(\n",
    "        {gene: idx for idx, gene in enumerate(ARTICLE_CONSENSUS_ORDER)}\n",
    "    )\n",
    "    # Put actual consensus genes mentioned in paper first, in its exact gene order.\n",
    "    s7['_article_first'] = np.where(s7.consensus_all_six & s7._article_gene_order.notna(), 0, 1)\n",
    "    s7 = s7.sort_values(\n",
    "        ['_article_first', '_article_gene_order', 'n_models_top10',\n",
    "         'mean_rank_among_selected_models', 'gene'],\n",
    "        ascending=[True, True, False, True, True], kind='stable', na_position='last'\n",
    "    ).drop(columns=['_article_gene_order', '_article_first'])\n",
    "    actual = set(s7.loc[s7.consensus_all_six, 'gene'])\n",
    "    expected = set(ARTICLE_CONSENSUS_ORDER)\n",
    "    print('  Six-model consensus:', ', '.join(sorted(actual)) if actual else 'none')\n",
    "    if actual != expected:\n",
    "        print('WARNING: six-model consensus differs from manuscript (SFMBT2, LCORL, ZFP36L2).')\n",
    "\n",
    "    # S8: ONE table, one row per held-out donor/model. Grid and selected settings merged.\n",
    "    all_tuning = []\n",
    "    for model in MODELS:\n",
    "        tune = read_model_file(model, TUNING_FILES[model],\n",
    "                               ('outer_test_donor', 'inner_macro_AP', 'inner_macro_ROC_AUC'))\n",
    "        tune['outer_test_donor'] = tune.outer_test_donor.astype(str)\n",
    "        non_params = {'outer_test_donor', 'inner_macro_AP', 'inner_macro_ROC_AUC'}\n",
    "        param_cols = [c for c in tune.columns if c not in non_params]\n",
    "        if not param_cols:\n",
    "            raise ValueError(f'{model}: no parameter columns in {TUNING_FILES[model]}')\n",
    "        n_grid = len(tune[param_cols].drop_duplicates())\n",
    "        grid = '; '.join(\n",
    "            f'{col}=[{\", \".join(sorted(set(tune[col].map(fmt))))}]' for col in param_cols\n",
    "        )\n",
    "        # Use this model's ORIGINAL performance columns.  pd.concat across six\n",
    "        # models introduces NaNs for columns owned by other models.\n",
    "        sub_perf = perf_by_model[model]\n",
    "        for _, row in sub_perf.iterrows():\n",
    "            donor = str(row.test_donor)\n",
    "            donor_tune = tune[tune.outer_test_donor.eq(donor)]\n",
    "            if donor_tune.empty:\n",
    "                raise ValueError(f'{model}: no inner tuning rows for donor {donor}')\n",
    "            chosen = {}\n",
    "            for param in param_cols:\n",
    "                best_key = f'best_{param}'\n",
    "                if best_key in row.index:\n",
    "                    value = row[best_key]\n",
    "                elif param in row.index:\n",
    "                    value = row[param]\n",
    "                else:\n",
    "                    raise ValueError(\n",
    "                        f'{model}: selected parameter {param} has no corresponding '\n",
    "                        'column in the model-specific performance file.'\n",
    "                    )\n",
    "\n",
    "                # An empty CSV field can be a legitimate hyperparameter choice:\n",
    "                # RF 'max_depth=None' means unlimited tree depth. Both CSVs\n",
    "                # encode None as NaN, so accept it ONLY if the inner search\n",
    "                # actually evaluated an empty/None setting for this donor.\n",
    "                if pd.isna(value) and not donor_tune[param].isna().any():\n",
    "                    raise ValueError(\n",
    "                        f'{model}, donor {donor}: selected {param} is blank, '\n",
    "                        'but there is no None/blank candidate in the tuning grid.'\n",
    "                    )\n",
    "                chosen[param] = value\n",
    "            match = pd.Series(True, index=donor_tune.index)\n",
    "            for param, val in chosen.items():\n",
    "                match &= donor_tune[param].map(fmt).eq(fmt(val))\n",
    "            selected = donor_tune.loc[match]\n",
    "            if len(selected) != 1:\n",
    "                print(f'WARNING: {model}, donor {donor}: {len(selected)} matching tuning rows.')\n",
    "            matched_row = selected.iloc[0] if not selected.empty else None\n",
    "            all_tuning.append({\n",
    "                'model': model,\n",
    "                'held_out_donor': donor,\n",
    "                'n_grid_combinations': n_grid,\n",
    "                'hyperparameter_search_space': grid,\n",
    "                'chosen_parameters': '; '.join(f'{key}={fmt(val)}' for key, val in chosen.items()),\n",
    "                'chosen_inner_macro_AP': (matched_row.inner_macro_AP if matched_row is not None else np.nan),\n",
    "                'chosen_inner_macro_ROC_AUC': (matched_row.inner_macro_ROC_AUC if matched_row is not None else np.nan),\n",
    "                'outer_AUROC': row.ROC_AUC,\n",
    "                'outer_AP': row.AP,\n",
    "            })\n",
    "    s8 = pd.DataFrame(all_tuning)\n",
    "    s8['_model_order'] = pd.Categorical(s8.model, categories=MODELS, ordered=True)\n",
    "    s8['_donor_order'] = pd.Categorical(s8.held_out_donor, categories=donor_order, ordered=True)\n",
    "    s8 = s8.sort_values(['_model_order', '_donor_order'], kind='stable').drop(\n",
    "        columns=['_model_order', '_donor_order']\n",
    "    )\n",
    "\n",
    "    # Additional tables are generated only when ALL SIX source files exist.\n",
    "    # This prevents incomplete tables silently omitting one classifier.\n",
    "    def load_all_models(file_for_model, required):\n",
    "        missing = []\n",
    "        for m in MODELS:\n",
    "            try:\n",
    "                find_model_file(m, file_for_model(m))\n",
    "            except FileNotFoundError as err:\n",
    "                missing.append(str(err))\n",
    "        if missing:\n",
    "            print('  Additional source data not complete; skipping this optional table:')\n",
    "            for message in missing:\n",
    "                print('   -', message)\n",
    "            return None\n",
    "        chunks = []\n",
    "        for m in MODELS:\n",
    "            chunk = read_model_file(m, file_for_model(m), required)\n",
    "            score_col = FOLD_SCORE_COLS[m]\n",
    "            if score_col not in chunk.columns:\n",
    "                raise ValueError(f'{m}: missing fold-level score column {score_col}')\n",
    "            chunk['model'] = m\n",
    "            chunk['importance_method'] = IMPORTANCE_FIELDS[m][1]\n",
    "            chunk['feature_score'] = pd.to_numeric(chunk[score_col], errors='raise')\n",
    "            chunk['outer_test_donor'] = chunk['outer_test_donor'].astype(str)\n",
    "            chunks.append(chunk)\n",
    "        combined = pd.concat(chunks, ignore_index=True)\n",
    "        return combined\n",
    "\n",
    "    def sort_by_paper_order(df, *more_columns):\n",
    "        df = df.copy()\n",
    "        df['_model_order'] = pd.Categorical(df['model'], categories=MODELS, ordered=True)\n",
    "        df['_donor_order'] = pd.Categorical(\n",
    "            df['outer_test_donor'], categories=donor_order, ordered=True\n",
    "        )\n",
